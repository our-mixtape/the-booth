# Optional. Server only. Never prefix this with VITE_.
OPENAI_API_KEY=

# Standalone Booth login. The publishable key is intentionally public; it is built into Vite.
VITE_CLERK_PUBLISHABLE_KEY=
# Server only. Configure directly in Vercel; never prefix this with VITE_.
CLERK_SECRET_KEY=
# Optional server-side override of the same publishable key (normally inferred from VITE_ above).
CLERK_PUBLISHABLE_KEY=
# Optional PEM public verification key from the SAME Clerk instance. Secret key remains required by the SDK.
CLERK_JWT_KEY=
# Exact public origin, for example https://mixtape-the-booth.vercel.app. Vercel system deployment URLs are also allowed.
APP_ORIGIN=
# Optional comma-separated Clerk user IDs for restricted Astra/voice beta access. Empty permits all signed-in users.
ASTRA_ALLOWED_USER_IDS=
