# Optional. Server only. Never prefix this with VITE_.
OPENAI_API_KEY=

# Standalone Booth login. The publishable key is intentionally public; it is built into Vite.
VITE_CLERK_PUBLISHABLE_KEY=
# Server only. Configure in Vercel and the persistent gateway; never prefix this with VITE_.
CLERK_SECRET_KEY=
# Optional server-side override of the same publishable key (normally inferred from VITE_ above).
CLERK_PUBLISHABLE_KEY=
# Optional PEM public verification key from the SAME Clerk instance. Secret key remains required by the SDK.
CLERK_JWT_KEY=
# Exact public origin, for example https://mixtape-the-booth.vercel.app. Vercel system deployment URLs are also allowed.
APP_ORIGIN=
# Optional comma-separated Clerk user IDs for restricted Astra/voice beta access. Empty permits all signed-in users.
ASTRA_ALLOWED_USER_IDS=

# Optional browser build setting. Only /api/session/* and its readiness check go here.
# Empty keeps same-origin local sessions and the existing Vercel HTTP hint behavior.
# Production requires an exact HTTPS origin; no paths, credentials or query strings.
VITE_ASTRA_GATEWAY_ORIGIN=

# Persistent gateway only; set in its secret store or ignored .env.gateway (mode 600).
# GATEWAY_MODE=persistent
# GATEWAY_HOST=0.0.0.0
# PORT=8787
# GATEWAY_PORT overrides PORT; PORT remains the frontend port under pnpm dev.
# ALLOWED_ORIGINS is a comma-separated list of exact HTTPS browser origins.
ALLOWED_ORIGINS=
# GATEWAY_DOMAIN is only used by deploy/gateway.compose.yaml (no https:// prefix).
# GATEWAY_DOMAIN=the-approved-gateway-hostname
